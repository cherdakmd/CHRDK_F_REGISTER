    "prefix": [
      "assets/",
      "logs/",
      "work-journal/",
      "src/",
      "update/",
      "update-backups/",
      "paid-audit/",
      "catalog-legacy-",
      "config-before-"
    ],
    "suffix": [
      ".jsonl",
      ".md",
      ".png",
      ".jpg",
      ".jpeg",
      ".ttf",
      ".zip",
      ".jar",
      ".log",
      ".csv",
      ".tmp",
      ".bak",
      ".broken"
    ],
    "comment": "Backups, .tmp, .bak and .broken siblings of runtime files are DB-backed and are discovered by runtime_globs."
